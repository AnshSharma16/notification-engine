DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/notifications
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

DEBUG=false

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=30
RETRY_JITTER=0.25

ADAPTER_TIMEOUT_SECONDS=10

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

BULK_BATCH_SIZE=500